{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://menteeai.org/schemas/source-registry-v1.schema.json",
  "title": "MenteE Code — Source Registry (v1)",
  "description": "Every dataset that enters the pipeline has an entry here. The licence gate is BLOCKING: an entry with trainable=false, or with no verified licence, is rejected at ingest.",
  "type": "object",
  "required": ["sources"],
  "additionalProperties": false,
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "url",
          "license",
          "license_verified",
          "trainable",
          "role",
          "added_at"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "description": "Stable identifier used in provenance.source_id."
          },
          "url": { "type": "string" },
          "sha256": {
            "type": ["string", "null"],
            "description": "Pinned artefact hash. Null only for sources fetched by API."
          },
          "revision": {
            "type": ["string", "null"],
            "description": "Dataset revision / commit. 'main' is not reproducible."
          },
          "license": {
            "type": "string",
            "description": "SPDX id of the DATA licence."
          },
          "license_url": { "type": ["string", "null"] },
          "license_verified": {
            "type": "boolean",
            "description": "A human or automated check read the actual licence text. False means UNKNOWN, and unknown is a reject."
          },
          "trainable": {
            "type": "boolean",
            "description": "May we train a commercial model on this? Distinct from the licence itself."
          },
          "redistributable": { "type": "boolean" },
          "attribution_required": { "type": "boolean" },
          "attribution_text": { "type": ["string", "null"] },
          "role": {
            "type": "string",
            "enum": ["train", "eval_only", "mixed"],
            "description": "eval_only sources are excluded from the training pipeline by construction."
          },
          "language": {
            "type": "array",
            "items": { "type": "string" }
          },
          "estimated_examples": { "type": ["integer", "null"] },
          "notes": { "type": "string" },
          "added_at": { "type": "string", "format": "date-time" },
          "added_by": { "type": "string" },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reviewed_by": { "type": "string" },
              "reviewed_at": { "type": "string", "format": "date-time" },
              "legal_note": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
