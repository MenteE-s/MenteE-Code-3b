# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Model & dataset scratch (large) ───────────────────────────────────────
# Scratch data is not tracked. Collector OUTPUT under datasets/ IS tracked -
# that is what the team pushes and what gets merged.
data/raw/
data/processed/
data/fetched/
data/repos/
data/workdirs/
models/
logs/
artifacts/
*.safetensors
*.bin
*.gguf
*.pt
*.pth
*.ckpt
*.parquet
*.arrow

# ── Secrets & keys (never commit) ─────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
secrets/
credentials.json

# ── Local config ──────────────────────────────────────────────────────────
configs/local_*.yaml
configs/local_*.json
.opencode.json
opencode.json

# ── Eval & report scratch ─────────────────────────────────────────────────
reports/*.tmp
*.log
!requirements*.txt

# ── OS / editor ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ── Hugging Face cache ────────────────────────────────────────────────────
.cache/
huggingface/
hf_cache/

# advisory lock + sidecar runtime files (ephemeral)
*.lock

.venv312/
datasets/collectors/*/debug-*.json
